{
  "name": "liquid-glass-terminal",
  "productName": "Liquid Glass Terminal",
  "version": "0.1.0",
  "description": "A local-first glass terminal for Windows, macOS, and Linux.",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "author": "Liquid Glass Terminal contributors",
  "license": "MIT",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:e2e": "node scripts/package-e2e.mjs",
    "make": "node scripts/make.mjs",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run",
    "audit:install-scripts": "node scripts/audit-install-scripts.mjs",
    "audit:production": "npm audit --omit=dev",
    "assets:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "verify:native-assets": "node scripts/verify-native-assets.mjs",
    "smoke:package": "node scripts/smoke-packaged.mjs",
    "bootstrap:native": "node scripts/bootstrap-native.mjs",
    "rebuild:native": "electron-rebuild --force --which-module node-pty"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-store": "11.0.2",
    "lucide-react": "1.31.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.2.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "png2icons": "2.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": [
      "darwin"
    ],
    "macos-alias@0.2.12": [
      "darwin"
    ],
    "node-pty@1.1.0": true
  }
}
